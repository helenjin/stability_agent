__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Machine-specific symlinks (recreate with scripts/setup_data.sh) and generated outputs.
# data/registry.yaml, data/README.md, and data/fixtures/ stay tracked.
data/raw/
data/stability_runs/
data/processed/
# Exported HF dataset snapshots (register-only policy: load via datasets, don't commit copies)
data/eli5/
*.arrow

# ares_topodev: LLM prompt cache is a large, non-source implementation
# artifact -- never committed. raw/aggregate results ARE committed once real
# (not mock/dry-run) data lands there -- see results_epsilon0.3/ and
# results/ (the paper-faithful epsilon=0.1 run) for precedent.
ares_topodev/results/cache/*
!ares_topodev/results/cache/.gitkeep
ares_topodev/results_smoketest/
ares_topodev/results_invalid/cache/
ares_topodev/results_invalid_epsilon0.1/cache/
ares_topodev/vendor/ares/src/exp_helpers/models/.llms*.py.cache/
